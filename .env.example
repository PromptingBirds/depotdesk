# Kopieren nach .env und bei Bedarf anpassen. Es werden keine Secrets benötigt.

# Port des Webservers
PORT=3000

# Header, aus dem die Benutzerkennung gelesen wird (siehe docs/adr/0002-authentifizierung-ueber-reverse-proxy.md)
AUTH_HEADER=x-depotdesk-user

# Startwert für die generierten Demo-Daten. Gleicher Wert = gleiche Daten.
SEED=42

# Optional: Stichtag für die Demo-Daten (ISO-Datum). Standard ist heute.
# SEED_REFERENCE_DATE=2026-10-01
